// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // for local development
  url      = env("DATABASE_URL")
  // for Vercel
  // url       = env("POSTGRES_PRISMA_URL")
  // directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum Role {
  USER
  ADMIN
}

model User {
  id       Int       @id @default(autoincrement())
  email    String    @unique
  username String    @unique
  password String
  favorites String[] @default([])
  language String    @default("English")
  role     Role      @default(USER)
}

model CampusCenterMenus {
  id         Int       @id @default(autoincrement())
  week_of    String    @default("1996-12-29")
  location   Location  @default(CAMPUS_CENTER)
  menu       Json      @default("[]")
  language   String    @default("English")
}

model GatewayMenus {
  id         Int       @id @default(autoincrement())
  date    String       @default("1996-12-29")
  location   Location  @default(GATEWAY)
  menu       Json      @default("[]")
  language   String    @default("English")
}

model HaleAlohaMenus {
  id         Int       @id @default(autoincrement())
  date       String    @default("1996-12-29")
  location   Location  @default(HALE_ALOHA)
  menu       Json      @default("[]")
  language   String    @default("English")
}

enum Location {
  CAMPUS_CENTER
  GATEWAY
  HALE_ALOHA
}

model FoodTable {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  url          String   
  label        String[]
  translation  String[]
  likes        Int      @default(0)
}

model AIStatus {
  id        Int     @id @default(autoincrement())
  menu_id   Int
  status    String  @default("pending")
}

model AiTokenUsage {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now())
  operation        String
  model            String
  language         String?
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  reasoningTokens  Int      @default(0)
  cachedInputTokens Int     @default(0)
  totalTokens      Int      @default(0)
  inputCost        Decimal  @db.Decimal(12, 8)
  outputCost       Decimal  @db.Decimal(12, 8)
  responseId       String?
}

model SdxStringTranslation {
  id               Int       @id @default(autoincrement())
  sourceHash       String
  language         String
  sourceText       String
  translatedText   String
  aiTranslatedText String
  isCorrected      Boolean   @default(false)
  correctedAt      DateTime?
  correctedBy      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([sourceHash, language])
  @@index([language])
  @@index([language, isCorrected])
}

model SdxTranslationLock {
  language  String   @id
  holder    String
  expiresAt DateTime
}